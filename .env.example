# Copy this file to ".env" and fill in what you have.
# Missing keys are fine — that source/notifier just skips itself.
# NEVER commit .env to git or share it.

# --- eBay (developer.ebay.com -> your app -> PRODUCTION keys) ---------------
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- Reddit (reddit.com/prefs/apps -> create app, type "script") ------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=windows:kaps-deal-finder:v1.0

# --- Discord (Server Settings -> Integrations -> Webhooks -> Copy URL) ------
DISCORD_WEBHOOK_URL=

# --- Email (optional; enable in settings.yaml first) ------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_TO=
